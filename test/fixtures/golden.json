  "validate_cases": [
    {
      "name": "a complete Organization is valid",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": true,
        "errors": [],
        "items": [
          {
            "type": "Organization",
            "valid": true,
            "errors": []
          }
        ]
      }
    },
    {
      "name": "a Product without offers misses a required field",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": \"Product\", \"name\": \"Widget\"}",
      "expected": {
        "ok": false,
        "errors": [
          "missing required field \"offers\" for @type \"Product\""
        ],
        "items": [
          {
            "type": "Product",
            "valid": false,
            "errors": [
              "missing required field \"offers\" for @type \"Product\""
            ]
          }
        ]
      }
    },
    {
      "name": "http and a trailing slash are schema.org too",
      "input": "{\"@context\": \"http://schema.org/\", \"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": true,
        "errors": [],
        "items": [
          {
            "type": "Organization",
            "valid": true,
            "errors": []
          }
        ]
      }
    },
    {
      "name": "a context that is not schema.org is flagged",
      "input": "{\"@context\": \"https://example.org/\", \"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": false,
        "errors": [
          "unexpected \"@context\": \"https://example.org/\""
        ],
        "items": [
          {
            "type": "Organization",
            "valid": false,
            "errors": [
              "unexpected \"@context\": \"https://example.org/\""
            ]
          }
        ]
      }
    },
    {
      "name": "a missing context is flagged",
      "input": "{\"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": false,
        "errors": [
          "missing \"@context\""
        ],
        "items": [
          {
            "type": "Organization",
            "valid": false,
            "errors": [
              "missing \"@context\""
            ]
          }
        ]
      }
    },
    {
      "name": "an empty-string context counts as missing",
      "input": "{\"@context\": \"\", \"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": false,
        "errors": [
          "missing \"@context\""
        ],
        "items": [
          {
            "type": "Organization",
            "valid": false,
            "errors": [
              "missing \"@context\""
            ]
          }
        ]
      }
    },
    {
      "name": "an array context is accepted as is",
      "input": "{\"@context\": [\"https://schema.org\", {\"@language\": \"it\"}], \"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": true,
        "errors": [],
        "items": [
          {
            "type": "Organization",
            "valid": true,
            "errors": []
          }
        ]
      }
    },
    {
      "name": "a list @type is labelled and checked by its first string",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": [\"Organization\", \"LocalBusiness\"], \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": true,
        "errors": [],
        "items": [
          {
            "type": "Organization",
            "valid": true,
            "errors": []
          }
        ]
      }
    },
    {
      "name": "a list @type that starts with LocalBusiness needs its fields",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": [5, \"LocalBusiness\", \"Organization\"], \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}",
      "expected": {
        "ok": false,
        "errors": [
          "missing required field \"address\" for @type \"LocalBusiness\"",
          "missing required field \"telephone\" for @type \"LocalBusiness\""
        ],
        "items": [
          {
            "type": "LocalBusiness",
            "valid": false,
            "errors": [
              "missing required field \"address\" for @type \"LocalBusiness\"",
              "missing required field \"telephone\" for @type \"LocalBusiness\""
            ]
          }
        ]
      }
    },
    {
      "name": "a missing @type is flagged",
      "input": "{\"@context\": \"https://schema.org\", \"name\": \"Acme\"}",
      "expected": {
        "ok": false,
        "errors": [
          "missing \"@type\""
        ],
        "items": [
          {
            "type": "Unknown",
            "valid": false,
            "errors": [
              "missing \"@type\""
            ]
          }
        ]
      }
    },
    {
      "name": "an empty object misses both context and type",
      "input": "{}",
      "expected": {
        "ok": false,
        "errors": [
          "missing \"@context\"",
          "missing \"@type\""
        ],
        "items": [
          {
            "type": "Unknown",
            "valid": false,
            "errors": [
              "missing \"@context\"",
              "missing \"@type\""
            ]
          }
        ]
      }
    },
    {
      "name": "a type we ship no template for is not an error",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": \"Thing\", \"name\": \"x\"}",
      "expected": {
        "ok": true,
        "errors": [],
        "items": [
          {
            "type": "Thing",
            "valid": true,
            "errors": []
          }
        ]
      }
    },
    {
      "name": "@graph items inherit the wrapper context",
      "input": "{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"Organization\", \"@id\": \"#org\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/l.png\"}, {\"@type\": \"WebSite\", \"name\": \"Acme\", \"url\": \"https://acme.test\"}]}",
      "expected": {
        "ok": true,
        "errors": [],
        "items": [
          {
            "type": "Organization",
            "valid": true,
            "errors": []
          },
          {
            "type": "WebSite",
            "valid": true,
            "errors": []
          }
        ]
      }
    },
    {
      "name": "a @graph item with its own context uses it",
      "input": "{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"WebSite\", \"name\": \"Acme\", \"url\": \"https://acme.test\"}, {\"@context\": \"https://example.org\", \"@type\": \"Thing\"}]}",
      "expected": {
        "ok": false,
        "errors": [
          "unexpected \"@context\": \"https://example.org\""
        ],
        "items": [
          {
            "type": "WebSite",
            "valid": true,
            "errors": []
          },
          {
            "type": "Thing",
            "valid": false,
            "errors": [
              "unexpected \"@context\": \"https://example.org\""
            ]
          }
        ]
      }
    },
    {
      "name": "a top-level array: each object needs its own context",
      "input": "[{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\"}, {\"@type\": \"WebSite\", \"name\": \"Acme\", \"url\": \"https://acme.test\"}]",
      "expected": {
        "ok": false,
        "errors": [
          "missing \"@context\""
        ],
        "items": [
          {
            "type": "Organization",
            "valid": true,
            "errors": []
          },
          {
            "type": "WebSite",
            "valid": false,
            "errors": [
              "missing \"@context\""
            ]
          }
        ]
      }
    },
    {
      "name": "an empty required list is flagged",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": []}",
      "expected": {
        "ok": false,
        "errors": [
          "required field \"mainEntity\" for @type \"FAQPage\" is empty"
        ],
        "items": [
          {
            "type": "FAQPage",
            "valid": false,
            "errors": [
              "required field \"mainEntity\" for @type \"FAQPage\" is empty"
            ]
          }
        ]
      }
    },
    {
      "name": "blank and null required fields are flagged",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"  \", \"url\": \"https://acme.test\", \"logo\": null}",
      "expected": {
        "ok": false,
        "errors": [
          "required field \"name\" for @type \"Organization\" is blank",
          "missing required field \"logo\" for @type \"Organization\""
        ],
        "items": [
          {
            "type": "Organization",
            "valid": false,
            "errors": [
              "required field \"name\" for @type \"Organization\" is blank",
              "missing required field \"logo\" for @type \"Organization\""
            ]
          }
        ]
      }
    },
    {
      "name": "a leftover placeholder is flagged",
      "input": "{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"Acme\", \"url\": \"https://acme.test\", \"logo\": \"https://acme.test/logo.png\", \"address\": {\"@type\": \"PostalAddress\", \"streetAddress\": \"{{STREET_ADDRESS}}\"}}",
      "expected": {
        "ok": false,
        "errors": [
          "still contains unfilled {{PLACEHOLDER}} tokens"
        ],
        "items": [
          {
            "type": "Organization",
            "valid": false,
            "errors": [
              "still contains unfilled {{PLACEHOLDER}} tokens"
            ]
          }
        ]
      }
    },
    {
      "name": "text that is not JSON",
      "input": "{\"@context\": \"https://schema.org\",",
      "expected": {
        "ok": false,
        "errors": [
          "invalid JSON"
        ],
        "items": []
      }
    },
    {
      "name": "a JSON value with no object in it",
      "input": "42",
      "expected": {
        "ok": false,
        "errors": [
          "no JSON-LD object found"
        ],
        "items": []
      }
    },
    {
      "name": "an array with no object in it",
      "input": "[1, \"two\", null]",
      "expected": {
        "ok": false,
        "errors": [
          "no JSON-LD object found"
        ],
        "items": []
      }
    },
    {
      "name": "empty input",
      "input": "   \n",
      "expected": {
        "ok": false,
        "errors": [
          "empty input"
        ],
        "items": []
      }
    }
  ]
}

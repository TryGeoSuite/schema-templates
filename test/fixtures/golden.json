      "description",
      "datePosted",
      "hiringOrganization"
    ],
    "LocalBusiness": [
      "name",
      "address",
      "telephone"
    ],
    "Organization": [
      "name",
      "url",
      "logo"
    ],
    "Product": [
      "name",
      "offers"
    ],
    "ProfilePage": [
      "mainEntity"
    ],
    "QAPage": [
      "mainEntity"
    ],
    "Recipe": [
      "name",
      "recipeIngredient",
      "recipeInstructions"
    ],
    "Review": [
      "author",
      "itemReviewed",
      "reviewRating"
    ],
    "Service": [
      "name",
      "provider"
    ],
    "SoftwareApplication": [
      "name",
      "applicationCategory",
      "operatingSystem",
      "offers"
    ],
    "VideoObject": [
      "name",
      "description",
      "thumbnailUrl",
      "uploadDate"
    ],
    "WebSite": [
      "name",
      "url"
    ]
  },
  "templates_sha256": {

{
  "_about": "Golden cases for the JSON-LD check of @geosuite/schema-templates (src/validate.js) and GeoSuite's Schema Helper (backend/services/tools/schema_helper_service.py). Both repos run every case; GeoSuite keeps a byte-identical copy in backend/tests/fixtures/schema_templates_golden.json. templates_sha256 pins the templates GeoSuite vendors in backend/data/schema_templates/. Change the rule and this file here first, then copy both to GeoSuite.",
  "required_by_type": {
    "Article": [
      "headline",
      "author",
      "publisher",
      "datePublished"
    ],
    "BlogPosting": [
      "headline",
      "author",
      "publisher",
      "datePublished"
    ],
    "BreadcrumbList": [
      "itemListElement"
    ],
    "Course": [
